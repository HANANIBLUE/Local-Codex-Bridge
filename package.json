{
  "name": "local-codex-bridge",
  "version": "2.2.0",
  "private": true,
  "description": "Local stdio MCP bridge for native Codex sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HANANIBLUE/Local-Codex-Bridge.git"
  },
  "bugs": {
    "url": "https://github.com/HANANIBLUE/Local-Codex-Bridge/issues"
  },
  "homepage": "https://github.com/HANANIBLUE/Local-Codex-Bridge#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/runtime.test.js dist/test/app-server.test.js dist/test/tools.test.js dist/test/mcp.test.js dist/test/checkpoint.test.js dist/test/ux-projection.test.js && npm run test:tray:if-supported",
    "test:tray": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File windows\\test-tray.ps1",
    "test:tray:if-supported": "node scripts/test-tray-if-supported.mjs",
    "start": "node dist/src/index.js",
    "smoke:live": "node scripts/live-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
